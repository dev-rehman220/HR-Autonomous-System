# Copy this file to `.env` and fill in real values.
#   cp .env.example .env

# Required: used by the LangGraph evaluation + question-generation nodes.
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: raises the GitHub REST API rate limit from 60 to 5000 req/hour.
# Leave blank to run unauthenticated.
GITHUB_TOKEN=

# Optional overrides (defaults shown).
# OPENAI_MODEL=gpt-4o-mini
# CHROMA_PATH=./chroma_db

# Use any OpenAI-compatible provider by setting BASE_URL + a matching MODEL.
# OPENAI_API_KEY still holds the provider's key. Examples:
#   Groq:        OPENAI_BASE_URL=https://api.groq.com/openai/v1        OPENAI_MODEL=llama-3.3-70b-versatile
#   OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1          OPENAI_MODEL=openai/gpt-4o-mini
#   DeepSeek:    OPENAI_BASE_URL=https://api.deepseek.com/v1           OPENAI_MODEL=deepseek-chat
#   Gemini:      OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_MODEL=gemini-2.0-flash
# OpenCode/Sisyphus: primary chain (comma-separated) then cross-provider fallbacks.
# OPENAI_MODEL accepts multiple models: "gemini-3.6-flash,gemini-3.5-flash".
# FALLBACK_* optionally point at a second provider tried if the primary chain fails.
#   FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#   FALLBACK_MODEL=liquid/lfm-2.5-2.6b:free
# OPENAI_BASE_URL=

# ---------------------------------------------------------------- #
# Screening behaviour
# ---------------------------------------------------------------- #
# Decision threshold used by route_decision(): fit_score >= this => INVITE,
# otherwise REJECT. Stored as 0-100.
FIT_THRESHOLD=70

# Real LLM context saving: resume text handed to the LLM is truncated to this
# many characters. Parsed fields (skills, links, education) are never truncated.
# MAX_RESUME_CHARS=20000
# MAX_PDF_PAGES=50

# ---------------------------------------------------------------- #
# Gmail ingestion (manual, on-demand — see the Inbox tab / scripts/fetch_inbox.py)
# ---------------------------------------------------------------- #
# local  = read *.eml files from a directory (offline, no Gmail needed)
# mcp    = call your Gmail MCP server
EMAIL_SOURCE=local
LOCAL_MAILBOX_PATH=tests/fixtures/mail

# EMAIL_SOURCE=mcp only:
# Command is split with shlex, e.g. "npx -y @gworkspace/gmail-mcp-server"
GMAIL_MCP_COMMAND=
# Or connect to a running server over SSE/streamable HTTP instead:
GMAIL_MCP_URL=
# Tool name used to search messages; auto-detected from tools/list if unset.
GMAIL_MCP_SEARCH_TOOL=search_emails
GMAIL_MCP_TIMEOUT=30

# Ingestion defaults (UI fields, each can be overridden per run)
GMAIL_LABEL=Candidates
GMAIL_QUERY=has:attachment
GMAIL_MAX_RESULTS=25
GMAIL_LOOKBACK_DAYS=30

# ---------------------------------------------------------------- #
# Applicant roster
# ---------------------------------------------------------------- #
# SQLite database holding applicants, dedup keys (cv_hash / message_id / email),
# skills, specializations and screening results.
ROSTER_DB_PATH=data/applicants.db

# Off by default: when true, every ingested applicant is immediately pushed
# through the full agentic screening (costs LLM calls). Leaving it false makes
# ingestion cheap and lets you screen on demand from the Roster tab.
SCREEN_ON_IMPORT=false

# Optional comma-separated specialization overrides, e.g. "Backend,Frontend,ML/AI"
# TAXONOMY_OVERRIDE=

# ---------------------------------------------------------------- #
# GitHub tool tuning
# ---------------------------------------------------------------- #
# Seconds to cache repo analysis per handle. 0 disables caching (default) so
# results are always fresh; raise to 300-3600 to save rate limit budget.
GITHUB_CACHE_TTL=0
